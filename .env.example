# Repota Environment Variables (Optional)
# Repota runs 100% offline-first without any environment variables.
# Copy this file to .env only if you want to configure optional telemetry keys.

# PostHog zero-PII product analytics (active only on allowed production hosts)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
